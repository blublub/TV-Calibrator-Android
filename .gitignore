# macOS
.DS_Store

# Xcode's original Git history, set aside before publishing (safe to delete)
.git-old-xcode-history/

# Xcode
xcuserdata/
DerivedData/
*.xcuserstate
build/

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Python
__pycache__/
*.pyc
.fixture-home/

# Pattern videos are published on YouTube / Cloudflare R2, not in the repo
*.mp4
!mac-lab/TV Calibrator.app/Contents/Resources/clips/**/*.mp4
*.zip

# Apple push keys never belong in the repo
*.p8

# The server address and the worker's name and storage id stay out of the public repo
# (copy the .example files; see docs/HOSTING.md)
TV Calibrator/Resources/ServerConfig.plist
push-worker/wrangler.toml

# Wrangler's local cache (holds the Cloudflare account id)
.wrangler/

# ---- Android (TV Calibrator Android) ----
# Gradle / build output
.gradle/
**/build/
*.apk
*.aab
*.ap_
*.dex
captures/
.externalNativeBuild/
.cxx/
# local.properties holds the local SDK path (includes the Windows user name)
local.properties
# Signing keys and secrets never belong in the repo
*.jks
*.keystore
keystore.properties
signing.properties
google-services.json
secrets.properties
.env
.env.*
# IDE
.idea/
*.iml
.vscode/
# Device logs, screenshots and recordings from testing
*.logcat
logcat*.txt
bugreport*.zip
device-screenshots/
# Local Claude Code settings
.claude/settings.local.json
