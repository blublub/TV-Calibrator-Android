    <!-- Welcome (WelcomeView.kt) -->
    <string name="home_welcome">Welcome</string>
    <string name="home_get_started">Get started</string>
    <string name="home_welcome_video_title">New to calibration? Start with the video</string>
    <string name="home_welcome_video_text">This app goes with Slidebean\'s videos on what calibration does to a TV\'s picture, with a full session start to finish. If you haven\'t seen them, they\'re worth a few minutes first.</string>
    <string name="home_welcome_tv_title">Make your TV look the way the film was made</string>
    <string name="home_welcome_tv_text">Most TVs come out of the box too blue, too bright and too saturated. %1$s walks you through your TV\'s own picture settings until they match the standard that films and shows are made to.</string>
    <string name="home_welcome_meter_title">Your phone is the meter</string>
    <string name="home_welcome_meter_text">The TV plays test-pattern videos from Slidebean\'s YouTube channel. Your phone\'s camera reads each colour, and the app tells you which setting to change and by how much. Nothing is installed on the TV.</string>
    <string name="home_welcome_meter_bullet1">Start from the most accurate picture mode (often Filmmaker Mode), then fine-tune it</string>
    <string name="home_welcome_meter_bullet2">One step at a time: white, greys, then colours</string>
    <string name="home_welcome_meter_bullet3">A before and after score at the end</string>
    <string name="home_welcome_need_title">What you need</string>
    <string name="home_welcome_need_text">No TV handy? Try the demo on the home screen to see how it works.</string>
    <string name="home_welcome_need_bullet1">Your TV\'s remote</string>
    <string name="home_welcome_need_bullet2">The YouTube app on the TV</string>
    <string name="home_welcome_need_bullet3">Something to stand the phone on, 15–30 cm from the screen</string>
    <string name="home_welcome_need_bullet4">A dark room</string>
